---
/**
 * The product's core gesture, playable in the page.
 *
 * Press and drag over the map and the call sheet below re-filters to the
 * practices inside the box, sorted by score, exactly as the app does. This is
 * the one thing a static screenshot can never convey: that the rectangle *is*
 * the query.
 *
 * The basemap is real OpenStreetMap tiles of Scottsdale, Arizona, fetched once
 * by `tools/fetch-map.mjs` and shipped as an image — no live tile requests per
 * visitor, nothing that can render as a grey box when a third party
 * rate-limits.
 *
 * The practices are invented. A page advertising a lead tool must not publish
 * real clinics' phone numbers, and the demo needs positions that suit the
 * frame rather than wherever real practices happen to sit.
 *
 * Every number here is in 555-0100..555-0199, which the North American
 * Numbering Plan reserves for fictional use and never assigns to a subscriber.
 * That matters more than the disclaimer below: an earlier version of this file
 * used realistic Phoenix-area numbers, and labelling them "invented" would not
 * have stopped a visitor dialling a stranger. **Keep any number added here
 * inside that range** — the area code may vary for local plausibility, the
 * exchange and line may not.
 *
 * Progressive enhancement: the initial selection is rendered on the server, so
 * the section is populated and correct with JavaScript disabled. The script
 * only takes over once someone interacts.
 */

interface Practice {
  /** Position as a percentage of the map, so it scales with the image. */
  x: number;
  y: number;
  name: string;
  city: string;
  phone: string;
  ask: string;
  role: string;
  score: number;
  status: 'new' | 'no-answer' | 'follow-up' | 'interested';
}

const STATUS_LABEL: Record<Practice['status'], string> = {
  'new': 'New',
  'no-answer': 'No answer',
  'follow-up': 'Follow up',
  'interested': 'Interested',
};

const PRACTICES: Practice[] = [
  { x: 31, y: 34, name: 'Ironwood Pediatric Dentistry', city: 'Scottsdale, AZ', phone: '(480) 555-0101', ask: 'Lisa B.', role: 'CEO', score: 100, status: 'new' },
