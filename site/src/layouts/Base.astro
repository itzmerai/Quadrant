---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/**
 * Every in-page link goes through this so the `/Quadrant/` subpath is applied
 * once, here, rather than remembered at each call site. A link that forgets it
 * 404s only on the deployed site, never in local dev — the worst place for the
 * mistake to hide.
 */
const base = import.meta.env.BASE_URL;
const href = (p: string) => (base.endsWith('/') ? base : base + '/') + p.replace(/^\//, '');

const REPO = 'https://github.com/itzmerai/Quadrant';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" href={href('logo.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={href('logo.png')} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <header class="site-head">
      <div class="site-head-in">
        <a class="brand-link" href={href('')}>
          <img src={href('logo.png')} alt="" width="24" height="24" />
          Quadrant
        </a>
        <nav class="site-nav">
          <a href={href('guide/')}>Guide</a>
          <a href={href('download/')}>Download</a>
          <a href={REPO}>Source</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>
          Practice data comes from the
          <a href="https://npiregistry.cms.hhs.gov/">CMS NPPES registry</a>,
          published by the US government as public record. Quadrant is not
          affiliated with CMS.
        </p>
        <p>
          <a href={REPO}>Source on GitHub</a> ·
          <a href={href('download/')}>Download</a>
        </p>
      </div>
    </footer>
  </body>
</html>
