{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadrant",
  "version": "0.1.0",
  "identifier": "dev.quadrant.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @quadrant/ui",
    "beforeBuildCommand": "npm run build -w @quadrant/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Quadrant",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Map-based lead finder for medical virtual assistants",
    "longDescription": "Draw a named box on the map and Quadrant finds every small medical practice inside it, with a phone number and the name of the person who answers."
  }
}
